{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "WAIT"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "INPUT"
            },
            "keys": {
              "type": "array",
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "forward",
                  "back",
                  "left",
                  "right",
                  "jump",
                  "sneak",
                  "sprint",
                  "attack",
                  "use",
                  "drop"
                ]
              }
            },
            "look_delta": {
              "type": "object",
              "properties": {
                "yaw": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "pitch": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              },
              "required": [
                "yaw",
                "pitch"
              ],
              "additionalProperties": false
            },
            "hotbar": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          },
          "required": [
            "type",
            "keys",
            "look_delta"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "GUI_CLICK"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1279
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 719
            },
            "button": {
              "enum": [
                "left",
                "right"
              ]
            },
            "shift": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "button",
            "shift"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "KEY_PRESS"
            },
            "key": {
              "enum": [
                "f3",
                "inventory",
                "escape"
              ]
            }
          },
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "CHAT"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!\\s*/)[^\\r\\n]+$"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "explanation": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "required": [
        "evidence",
        "reason",
        "expected"
      ],
      "additionalProperties": false
    },
    "harness_update": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "observer",
                  "reasoner",
                  "actor",
                  "reviewer"
                ]
              }
            },
            "next_call_credits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          },
          "required": [
            "roles",
            "next_call_credits"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "action",
    "explanation"
  ],
  "additionalProperties": false
}
