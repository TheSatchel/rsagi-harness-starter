{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "vel": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              ],
              "items": false,
              "description": "[forward, right, turn] local input strengths. Positive=forward/right/clockwise. Translation clamped to unit length. turn=1 means +180 degrees per logical second, applied at +9 degrees per native tick.",
              "default": [
                0,
                0,
                0
              ]
            },
            "look": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "items": false,
              "description": "Relative degrees [yaw, pitch], +right/+down. Applied once before continuous vel turning. Native pitch clamps to [-90,90].",
              "default": [
                0,
                0
              ]
            },
            "do": {
              "enum": [
                "none",
                "mine",
                "attack",
                "use",
                "hold_use"
              ],
              "default": "none",
              "description": "At the current crosshair: hold mine, tap attack/use, or hold use. No target selection."
            },
            "ticks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 80,
              "default": 5,
              "description": "Logical client ticks only; zero wall-clock progress during inference."
            },
            "slot": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9,
              "description": "Visible hotbar key 1..9."
            },
            "mode": {
              "enum": [
                "walk",
                "sprint",
                "sneak"
              ],
              "default": "walk"
            },
            "jump": {
              "type": "boolean",
              "default": false,
              "description": "Optional explicit jump/swim input; vanilla auto-jump is enabled uniformly."
            }
          },
          "additionalProperties": false,
          "description": "Compact character control; missing fields reset to defaults, {} stops prior input. Not a world velocity setter or planner."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "WAIT"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "GUI_CLICK"
            },
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1279
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 719
            },
            "button": {
              "enum": [
                "left",
                "right"
              ]
            },
            "shift": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "button",
            "shift"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "KEY_PRESS"
            },
            "key": {
              "enum": [
                "f3",
                "inventory",
                "escape"
              ]
            }
          },
          "required": [
            "type",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "CHAT"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^(?!\\s*/)[^\\r\\n]+$"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "explanation": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "required": [
        "evidence",
        "reason",
        "expected"
      ],
      "additionalProperties": false
    },
    "harness_update": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "observer",
                  "reasoner",
                  "actor",
                  "reviewer"
                ]
              }
            },
            "next_call_credits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          },
          "required": [
            "roles",
            "next_call_credits"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "required": [
        "why"
      ],
      "not": {
        "required": [
          "explanation"
        ]
      }
    },
    {
      "required": [
        "explanation"
      ],
      "not": {
        "required": [
          "why"
        ]
      }
    }
  ]
}
