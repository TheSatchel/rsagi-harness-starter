  "components": {
    "securitySchemes": {
      "TeamBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "One opaque credential bound to one match and team, not a Minecraft or model-provider credential."
      }
    },
    "parameters": {
      "MatchID": {
        "in": "header",
        "name": "X-RSAGI-Match",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "description": "Bind every request to the session established at startup. Never auto-switch to a restarted/new match."
      },
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "description": "Reuse exactly the same key and body after uncertain transport. A changed body conflicts. Successful records remain for the match."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "human_view_capture": {
            "type": "boolean"
          },
          "native_game_execution": {
            "type": "boolean"
          },
          "real_model": {
            "type": "boolean"
          },
          "self_organization_config": {
            "type": "boolean"
          },
          "arbitrary_code_hot_update": {
            "type": "boolean"
          },
          "strict_certified": {
            "type": "boolean"
          }
        },
        "required": [
          "human_view_capture",
          "native_game_execution",
          "real_model",
          "self_organization_config",
          "arbitrary_code_hot_update",
          "strict_certified"
        ],
        "additionalProperties": false
      },
      "CharacterControl": {
        "type": "object",
        "properties": {
          "profile": {
            "const": "compact_vel3_v1"
          },
          "auto_jump": {
            "const": true
          },
          "turn_degrees_per_logical_second": {
            "const": 180
          },
          "default_action_ticks": {
            "const": 5
          },
          "max_action_ticks": {
            "const": 80
          },
          "hotbar_first_slot": {
            "const": 1
          }
        },
        "required": [
          "profile",
          "auto_jump",
          "turn_degrees_per_logical_second",
          "default_action_ticks",
          "max_action_ticks",
          "hotbar_first_slot"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "api_version": {
            "const": "0.3.0"
          },
          "mode": {
            "enum": [
              "protocol_mock",
              "native_training",
              "strict_competition"
            ]
          },
          "match_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "team_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "perception_policy": {
            "const": "rsagi-human-player-view-v1"
          },
          "ticks_per_round": {
            "const": 5
          },
          "rounds_per_logical_second": {
            "const": 4
          },
          "credit_cap": {
            "const": 16
          },
          "tokens_per_credit": {
            "const": 512
          },
          "seconds_per_credit": {
            "const": 10
          },
          "max_model_calls_per_round": {
            "const": 1
          },
          "f3_allowed": {
            "const": true
          },
          "screen": {
            "type": "object",
            "properties": {
              "width": {
                "const": 1280
              },
              "height": {
                "const": 720
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "character_control": {
            "$ref": "#/components/schemas/CharacterControl"
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          }
        },
        "required": [
          "api_version",
          "mode",
          "match_id",
          "team_id",
          "perception_policy",
          "ticks_per_round",
          "rounds_per_logical_second",
          "credit_cap",
          "tokens_per_credit",
          "seconds_per_credit",
          "max_model_calls_per_round",
          "f3_allowed",
          "screen",
          "character_control",
          "capabilities"
        ],
        "additionalProperties": false
      },
      "Round": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "protocol_mock",
              "native_training",
              "strict_competition"
            ]
          },
          "phase": {
            "enum": [
              "COLLECTING",
              "FINISHED",
              "ABORTED"
            ]
          },
          "round_id": {
            "type": "integer",
            "minimum": 1
          },
          "logical_tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "available_credits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "observation_ref": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "harness_revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "active_operation_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "recommended_call_credits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "disposition": {
            "enum": [
              "OPEN",
              "PENDING",
              "DECIDED",
              "READY"
            ]
          },
          "finished": {
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "phase",
          "round_id",
          "logical_tick",
          "available_credits",
          "observation_ref",
          "harness_revision",
          "active_operation_id",
          "recommended_call_credits",
          "disposition",
          "finished"
        ],
        "additionalProperties": false
      },
      "DecideRequest": {
        "type": "object",
        "properties": {
          "round_id": {
            "type": "integer",
            "minimum": 1
          },
          "observation_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "credits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
