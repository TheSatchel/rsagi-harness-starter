{
  "openapi": "3.1.1",
  "info": {
    "title": "RSAGI participant Harness API",
    "version": "0.3.0",
    "description": "PROTOCOL MOCK ONLY today. No live competition endpoint, native perception/execution or inference is connected. 512 tokens/10 seconds, 1280x720 are starter parameters, not frozen match rules."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "Local protocol mock; use its allocated loopback port. No production endpoint advertised.",
      "variables": {
        "port": {
          "default": "8000"
        }
      }
    }
  ],
  "security": [
    {
      "TeamBearer": []
    }
  ],
  "paths": {
    "/v1/session": {
      "get": {
        "operationId": "getSession",
        "description": "Own team binding and public protocol settings; capability booleans are not certification.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, values or idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid team credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or non-owned object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Round, quota, receipt, revision or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request body too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Host error; formal runtime must stop safely",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/round": {
      "get": {
        "operationId": "getRound",
        "description": "Own released boundary only; repeated reads never produce more world information. No other teams or world state.",
