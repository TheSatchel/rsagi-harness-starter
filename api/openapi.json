          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Host error; formal runtime must stop safely",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/MatchID"
          }
        ]
      }
    },
    "/v1/decisions": {
      "post": {
        "operationId": "createDecision",
        "description": "Atomically pre-charge one call. Host supplies bound perception and original context; request cannot contain prompts, images, history or actions.",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "400": {
